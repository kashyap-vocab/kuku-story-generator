# vLLM's OpenAI-compatible endpoint
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=not-needed
# Must match the name vLLM serves the model under (--served-model-name, or the model path)
LLM_MODEL=google/gemma-4-12b-it
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=2
# Set to true if the chat template rejects "system" messages
LLM_MERGE_SYSTEM_PROMPT=false

DB_PATH=data/story.db

# Hard limits per episode
EPISODE_TOKEN_BUDGET=150000
MAX_REVISIONS=2
